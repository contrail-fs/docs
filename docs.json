{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Contrail Docs",
  "colors": {
    "primary": "#F4D134",
    "light": "#DEB223",
    "dark": "#F4D134"
  },
  "favicon": "/images/Logo-Yellow.svg",
  "redirects": [
    {
      "source": "/aircraft/falcon-50/systems/checklists/quickstart",
      "destination": "/aircraft/falcon-50/procedures/checklists/quickstart"
    }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs",
          "hidden": true
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog",
          "hidden": true
        }
      ]
    },
    "products": [
      {
        "product": "Default",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "index",
                  "quickstart",
                  "development"
                ]
              },
              {
                "group": "Customization",
                "pages": [
                  "essentials/settings",
                  "essentials/navigation"
                ]
              },
              {
                "group": "Writing content",
                "pages": [
                  "essentials/markdown",
                  "essentials/code",
                  "essentials/images",
                  "essentials/reusable-snippets"
                ]
              },
              {
                "group": "AI tools",
                "pages": [
                  "ai-tools/cursor",
                  "ai-tools/claude-code",
                  "ai-tools/windsurf"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "groups": [
              {
                "group": "API documentation",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Endpoint examples",
                "pages": [
                  "api-reference/endpoint/get",
                  "api-reference/endpoint/create",
                  "api-reference/endpoint/delete",
                  "api-reference/endpoint/webhook"
                ]
              }
            ]
          }
        ],
        "hidden": true
      },
      {
        "product": "Aircraft",
        "icon": "plane-departure",
        "tabs": [
          {
            "tab": "Falcon 50",
            "groups": [
              {
                "group": "Introduction",
                "pages": [
                  "aircraft/falcon-50/introduction/welcome",
                  "aircraft/falcon-50/introduction/disclaimer-legal"
                ]
              },
              {
                "group": "Aircraft",
                "expanded": false,
                "pages": [
                  {
                    "group": "Cockpit Layout",
                    "pages": [
                      "aircraft/falcon-50/aircraft/cockpit-layout/front-panel",
                      "aircraft/falcon-50/aircraft/cockpit-layout/overhead-panel"
                    ]
                  }
                ]
              },
              {
                "group": "Systems",
                "expanded": false,
                "pages": [
                  {
                    "group": "Fuel System",
                    "pages": [
                      "aircraft/falcon-50/systems/fuel-system/overview",
                      "aircraft/falcon-50/systems/fuel-system/fuel-gauges",
                      "aircraft/falcon-50/systems/fuel-system/forward-tanks",
                      "aircraft/falcon-50/systems/fuel-system/fuel-transfer-system",
                      "aircraft/falcon-50/systems/fuel-system/engine-feed-system"
                    ]
                  },
                  {
                    "group": "Electrical System",
                    "pages": [
                      "aircraft/falcon-50/systems/electrical-system/overview",
                      "aircraft/falcon-50/systems/electrical-system/dc-power",
                      "aircraft/falcon-50/systems/electrical-system/ac-power",
                      "aircraft/falcon-50/systems/electrical-system/ground-power",
                      "aircraft/falcon-50/systems/electrical-system/battery-temperature"
                    ]
                  }
                ]
              },
              {
                "group": "Procedures",
                "expanded": false,
                "pages": [
                  {
                    "group": "Checklists",
                    "pages": [
                      "aircraft/falcon-50/procedures/checklists/quickstart"
                    ]
                  }
                ]
              },
              {
                "group": "Hardware",
                "pages": [
                  "aircraft/falcon-50/hardware/keybindings"
                ]
              },
              {
                "group": "Troubleshooting",
                "pages": [
                  "aircraft/falcon-50/troubleshooting/debug-logs"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/contrail-logo-light.svg",
    "dark": "/images/contrail-logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
